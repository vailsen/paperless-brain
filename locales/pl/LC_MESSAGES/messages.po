#: app_ui/ai_models_settings.py:425
msgid ""
"Your models are now grouped by service — one entry per address. The names "
"marked \"suggested\" were made up from the address: open each one and give "
"it a name."
msgstr ""
"Twoje modele są teraz pogrupowane według usługi — jeden wpis na adres. Nazwy"
" oznaczone jako „sugerowane” zostały utworzone na podstawie adresu: otwórz "
"każdy z nich i nadaj mu nazwę."

#: app_ui/ai_models_settings.py:445
msgid "suggested"
msgstr "sugerowany"

#: app_ui/ai_models_settings.py:449
msgid "local"
msgstr "lokalny"

#: app_ui/ai_models_settings.py:456 app_ui/ai_models_settings.py:496
msgid "Move up"
msgstr "Przesuń w górę"

#: app_ui/ai_models_settings.py:457 app_ui/ai_models_settings.py:498
msgid "Move down"
msgstr "Przesuń w dół"

#: app_ui/ai_models_settings.py:465
msgid "No models yet."
msgstr "Brak modeli."

#: app_ui/ai_models_settings.py:488
msgid "no tools"
msgstr "bez narzędzi"

#: app_ui/ai_models_settings.py:491
msgid "Limited — cannot search documents, emails or notes."
msgstr "Ograniczony — nie można wyszukiwać dokumentów, e-maili ani notatek."

#: app_ui/ai_models_settings.py:508
msgid ""
"One entry per service, with any number of models below it. Models appear in "
"dropdowns in this order, grouped by service.<br><b>OpenAI-compatible</b>: "
"Ollama (<code>http://host:11434/v1</code>), OpenRouter "
"(<code>https://openrouter.ai/api/v1</code>), MiniMax, Moonshot, "
"…<br><b>Anthropic-compatible</b>: Anthropic API (empty base URL), MiniMax "
"and other providers with an Anthropic-compatible endpoint."
msgstr ""
"Jeden wpis na usługę, z dowolną liczbą modeli poniżej. Modele pojawiają się "
"w rozwijanych listach w tej kolejności, pogrupowane według "
"usługi.<br><b>Kompatybilny z OpenAI</b>: Ollama "
"(<code>http://host:11434/v1</code>), OpenRouter "
"(<code>https://openrouter.ai/api/v1</code>), MiniMax, Moonshot, "
"…<br><b>Kompatybilny z Anthropic</b>: Anthropic API (pusta baza URL), "
"MiniMax i inni dostawcy z punktem końcowym kompatybilnym z Anthropic."

