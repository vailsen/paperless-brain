#: app_ui/pages/settings.py:483
msgid ""
"After each sync, documents whose AI-extracted text differs from the text in "
"Paperless-ngx are updated there. This improves the Paperless full-text "
"search. <b style='color:#f87171'>The previous OCR text is overwritten and "
"cannot be restored by Paperless-ngx.</b> Reprocessing a document in "
"Paperless-ngx replaces the text with its own OCR again."
msgstr ""
