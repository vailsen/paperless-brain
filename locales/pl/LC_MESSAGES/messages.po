msgid "Max. output tokens (thinking + answer, 0 = default 16384)"
msgstr ""
"Maksymalna liczba tokenów wyjściowych (myślenie + odpowiedź, 0 = domyślne "
"16384)"

#: app_ui/ai_models_settings.py:216
msgid "Auto (model default)"
msgstr "Automatycznie (ustawienie domyślne modelu)"

#: app_ui/ai_models_settings.py:216
msgid "Thinking ON"
msgstr "Myślenie WŁ."

#: app_ui/ai_models_settings.py:216
msgid "Thinking OFF"
msgstr "Myślenie WYŁ."

#: app_ui/ai_models_settings.py:217
msgid "Thinking mode"
msgstr "Tryb myślenia"

#: app_ui/ai_models_settings.py:222
msgid ""
"\"Auto\" leaves the decision to the model — Claude then never thinks, and "
"other models only sometimes. Set it explicitly to decide yourself."
msgstr ""
"\"Auto\" pozostawia decyzję modelowi — Claude nigdy nie myśli, a inne modele"
" tylko czasami. Ustaw to jawnie, aby sam zdecydować."

#: app_ui/ai_models_settings.py:236
msgid "Model default"
msgstr "Ustawienie domyślne modelu"

#: app_ui/ai_models_settings.py:237 proactive/notify/__init__.py:25
msgid "Low"
msgstr "Niski"

#: app_ui/ai_models_settings.py:238 proactive/notify/__init__.py:26
msgid "Medium"
msgstr "Średni"

#: app_ui/ai_models_settings.py:239 proactive/notify/__init__.py:27
msgid "High"
msgstr "Wysoki"

#: app_ui/ai_models_settings.py:240
msgid "Very high"
msgstr "Bardzo wysoki"

#: app_ui/ai_models_settings.py:241
msgid "Maximum"
msgstr "Maksymalne"

#: app_ui/ai_models_settings.py:243
msgid "Thinking effort (Anthropic, no base URL)"
msgstr "Wysiłek myślenia (Thinking effort - Anthropic, bez bazowego adresu URL)"

#: app_ui/ai_models_settings.py:248
msgid "Thinking budget in tokens (0 = 4096)"
msgstr "Budżet myślenia w tokenach (0 = 4096)"

#: app_ui/ai_models_settings.py:254
msgid "⚠ Qwen3 thinking-loop risk at temp. < 0.5 — recommended: ≥ 0.6"
msgstr "⚠ Ryzyko pętli myślowej Qwen3 przy temp. < 0.5 — zalecane: ≥ 0.6"

#: app_ui/ai_models_settings.py:262
msgid "Model can use tools"
msgstr "Model może używać narzędzi"

#: app_ui/ai_models_settings.py:266
msgid ""
"Off: this model is never offered tools. Use for models that cannot call them"
" reliably — better a model that says it does not know than one that invents "
"an answer."
msgstr ""
"Wyłączone: temu modelowi nigdy nie są oferowane narzędzia. Używaj dla "
"modeli, które nie mogą ich niezawodnie wywołać — lepiej model, który mówi, "
"że nie wie, niż ten, który wymyśla odpowiedź."

#: app_ui/ai_models_settings.py:272
msgid "Require a tool for personal questions"
msgstr "Wymaga narzędzia do pytań osobistych"

#: app_ui/ai_models_settings.py:277
msgid ""
"For questions about your own documents, emails or purchases, the first "
"request already demands a tool call. Switch on for models that answer such "
"questions from memory."
msgstr ""
"W przypadku pytań dotyczących Twoich własnych dokumentów, e-maili lub "
"zakupów, pierwsze zapytanie już wymaga wywołania narzędzia. Włącz modele, "
"które odpowiadają na takie pytania z pamięci."

#: app_ui/ai_models_settings.py:286
msgid "Model ID must not be empty."
msgstr "Identyfikator modelu nie może być pusty."

#: app_ui/ai_models_settings.py:292
#, python-brace-format
msgid ""
"Another model is already called \"{name}\" — choose a different display "
"name."
msgstr "Inny model już nazywa się \"{name}\" — wybierz inną nazwę wyświetlania."

