#: app_ui/compose_dialogs.py:127
msgid "What should it say? (optional)"
msgstr "Co ma zawierać wiadomość? (opcjonalnie)"

#: app_ui/compose_dialogs.py:144
msgid "Draft from the conversation — check every field."
msgstr "Projekt na podstawie rozmowy. Sprawdź wszystkie pola."

#: app_ui/compose_dialogs.py:146
msgid "The model returned no usable draft — fill in the fields."
msgstr "Model nie wygenerował użytecznego projektu. Uzupełnij pola ręcznie."

#: app_ui/layout.py:433 app_ui/pages/admin.py:88
msgid "Admin"
msgstr "Administracja"

#: app_ui/tool_trace.py:189
msgid "Download raw conversation with system prompt, without thinking (.md)"
msgstr ""
"Pobierz pełny zapis rozmowy z promptem systemowym, bez procesu rozumowania "
"(.md)"

#: app_ui/tool_trace.py:193
#, python-brace-format
msgid ""
"{calls} model requests ({model_s}) · {tools} tool calls ({tool_s}) · tokens "
"in {tin} / out {tout}"
msgstr ""
"Żądania do modelu: {calls} ({model_s}) · wywołania narzędzi: {tools} "
"({tool_s}) · tokeny wejściowe: {tin} / wyjściowe: {tout}"

#: app_ui/pages/admin.py:71
msgid "The admin area is open to the users named in ADMIN_USERS on the server."
msgstr ""
"Dostęp do panelu administracyjnego mają użytkownicy wymienieni w zmiennej "
"ADMIN_USERS na serwerze."

#: app_ui/pages/admin.py:79
msgid "Ready"
msgstr "Gotowy"

#: app_ui/pages/admin.py:89
msgid "Settings for every user. Admins are named in ADMIN_USERS on the server."
msgstr "Ustawienia wspólne dla wszystkich użytkowników. Dostęp administracyjny mają użytkownicy wskazani w zmiennej ADMIN_USERS na serwerze."


#: app_ui/pages/admin.py:98
msgid "Search reads the active model's index, for every user"
msgstr ""
"Wyszukiwanie korzysta z indeksu aktywnego modelu dla wszystkich użytkowników."

#: app_ui/pages/admin.py:153
#, python-brace-format
msgid ""
"This server's copy gives different vectors (cosine {mean}), so this index "
"cannot embed here. Rebuild it on this server if search should not depend on "
"the endpoint."
msgstr ""
"Model uruchomiony na tym serwerze generuje inne wektory (podobieństwo "
"cosinusowe: {mean}), dlatego nie można tutaj tworzyć embeddingów dla tego "
"indeksu. Jeśli wyszukiwanie ma działać niezależnie od zdalnego punktu "
"końcowego, przebuduj indeks na tym serwerze."

#: app_ui/pages/admin.py:158
msgid "on the remote endpoint"
msgstr "na zdalnym punkcie końcowym"

#: app_ui/pages/admin.py:159
#, python-brace-format
msgid ""
"Next: build the index {where}. Search keeps using the active index meanwhile."
msgstr ""
"Następny krok: zbuduj indeks {where}. W tym czasie wyszukiwanie nadal "
"korzysta z aktywnego indeksu."

#: app_ui/pages/admin.py:162
msgid "To build on a GPU instead, add its endpoint under Edit."
msgstr ""
"Aby zbudować indeks na GPU, dodaj jego punkt końcowy w sekcji „Edytuj”."

#: app_ui/pages/admin.py:165
msgid "The build stopped before the end. It continues where it stopped."
msgstr ""
"Budowanie zostało przerwane przed zakończeniem. Zostanie wznowione od "
"miejsca przerwania."

#: app_ui/pages/admin.py:168
msgid ""
"Ready. Next: compare it with the active index, set its distance thresholds "
"from the distances you see, then make it active."
msgstr ""
"Gotowe. Następnie porównaj indeks z aktywnym, ustaw progi odległości na "
"podstawie uzyskanych wyników i aktywuj go."

#: app_ui/pages/admin.py:171
msgid ""
"It embeds remotely: once active, every search asks the endpoint — while it "
"is off, search finds nothing. Switch to this server above at any time."
msgstr ""
"Embeddingi są tworzone zdalnie. Po aktywowaniu indeksu każde wyszukiwanie "
"będzie wysyłać żądanie do punktu końcowego. Gdy będzie on niedostępny, "
"wyszukiwanie nie zwróci wyników. W każdej chwili możesz przełączyć "
"przetwarzanie na ten serwer, korzystając z opcji powyżej."

#: app_ui/pages/admin.py:187
msgid ""
"Checking that this server and the endpoint give the same vectors — the first "
"time this downloads the model here (about 1–2 GB) …"
msgstr ""
"Sprawdzanie, czy ten serwer i zdalny punkt końcowy generują identyczne "
"wektory. Przy pierwszym uruchomieniu model zostanie pobrany na ten serwer "
"(około 1–2 GB)…"

#: app_ui/pages/admin.py:201
msgid "Same vectors both ways — switched."
msgstr "Wektory są identyczne. Przełączono."

#: app_ui/pages/admin.py:203
#, python-brace-format
msgid "Different vectors (cosine {mean}) — it stays as it was."
msgstr ""
"Wektory się różnią (podobieństwo cosinusowe: {mean}). Nie zmieniono ustawień."

#: app_ui/pages/admin.py:240
msgid "Dormant"
msgstr "Nieaktywny"

#: app_ui/pages/admin.py:241
msgid "Was active; not updated until it is active again"
msgstr "Był aktywny. Nie będzie aktualizowany do czasu ponownej aktywacji."

#: app_ui/pages/admin.py:247
msgid "in RAM"
msgstr "w pamięci RAM"

#: app_ui/pages/admin.py:252
msgid "Catch up"
msgstr "Nadrób zaległości"

#: app_ui/pages/admin.py:267
msgid "Embeds on"
msgstr "Tworzy embeddingi na"

#: app_ui/pages/admin.py:277
#, python-brace-format
msgid ""
"{docs} documents ({dc} chunks) · {notes} notes ({nc} chunks) · {facts} "
"memory facts"
msgstr ""
"Dokumenty: {docs} ({dc} fragmentów) · notatki: {notes} ({nc} fragmentów) · "
"fakty w pamięci: {facts}"

#: app_ui/pages/admin.py:292
msgid "Starting … (a remote host may need to wake up first)"
msgstr "Uruchamianie… (zdalny host może najpierw wymagać wybudzenia)"

#: app_ui/pages/admin.py:296
msgid "Stops after this batch."
msgstr "Zatrzyma się po zakończeniu bieżącej partii."

#: app_ui/pages/admin.py:306
#, python-brace-format
msgid "Caught up with the active index: {when}"
msgstr "Zsynchronizowano z aktywnym indeksem: {when}"

#: app_ui/pages/admin.py:309
#, python-brace-format
msgid "Last run: {n} embedded in {t}"
msgstr "Ostatnie uruchomienie: utworzono {n} embeddingów w czasie {t}"

#: app_ui/pages/admin.py:316
#, python-brace-format
msgid "Local against remote: cosine {mean} (lowest {min}) — {verdict}"
msgstr ""
"Lokalny i zdalny model: podobieństwo cosinusowe {mean} (najniższe {min}) — "
"{verdict}"

#: app_ui/pages/admin.py:318
msgid "the same model"
msgstr "ten sam model"

#: app_ui/pages/admin.py:318
msgid "not the same vectors"
msgstr "różne wektory"

#: app_ui/pages/admin.py:321
msgid "Every search asks this endpoint; while it is off, search finds nothing."
msgstr ""
"Każde wyszukiwanie wysyła żądanie do tego punktu końcowego. Gdy jest "
"niedostępny, wyszukiwanie nie zwraca wyników."

#: app_ui/pages/admin.py:324
#, python-brace-format
msgid ""
"Distances: memory hint ≤ {mh} (× {mw}) · archive hint ≤ {ah} · similar fact "
"≤ {fd}"
msgstr ""
"Odległości: podpowiedzi z pamięci ≤ {mh} (× {mw}) · podpowiedzi z archiwum ≤ "
"{ah} · podobny fakt ≤ {fd}"

#: app_ui/pages/admin.py:331
#, python-brace-format
msgid ""
"{n} documents have chunks of an older version (no title and summary in their "
"header, or cut off by the model's window). Rebuilding them needs no vision "
"model."
msgstr "Fragmenty {n} dokumentów utworzono według wcześniejszych zasad (bez tytułu i podsumowania w nagłówku lub z przycięciem do okna kontekstowego modelu). Ich przebudowa nie wymaga modelu wizyjnego."


#: app_ui/pages/admin.py:373
msgid ""
"Cuts every outdated document into chunks again from its stored extraction, "
"with title and summary in the header and within the model's window, and "
"embeds them with the active model. No vision model. Search keeps working "
"meanwhile; a stop or a restart keeps what is done, and the next run "
"continues."
msgstr ""
"Ponownie podzieli wszystkie nieaktualne dokumenty na fragmenty na podstawie "
"zapisanej ekstrakcji, dodając tytuł i podsumowanie do nagłówka oraz "
"dopasowując długość do okna kontekstowego modelu. Następnie utworzy "
"embeddingi aktywnym modelem. Model wizyjny nie jest potrzebny. Wyszukiwanie "
"będzie nadal działać. Po zatrzymaniu lub restarcie postęp zostanie "
"zachowany, a kolejne uruchomienie wznowi pracę."

#: app_ui/pages/admin.py:397
#, python-brace-format
msgid "Make \"{name}\" active?"
msgstr "Aktywować „{name}”?"

#: app_ui/pages/admin.py:400
msgid ""
"Its index is first brought up to date with the active one, then every search "
"of every user reads it. The current index stays as it is, dormant: it is no "
"longer updated until it is made active again."
msgstr ""
"Najpierw indeks zostanie zaktualizowany do stanu aktywnego indeksu. "
"Następnie wszystkie wyszukiwania wszystkich użytkowników będą korzystać z "
"nowego indeksu. Dotychczasowy indeks pozostanie nieaktywny i nie będzie "
"aktualizowany do czasu ponownej aktywacji."

#: app_ui/pages/admin.py:418
msgid ""
"Its vectors for documents, notes and memory are deleted, and the model's "
"files on this server — a remote endpoint is not touched. The documents, "
"notes and extractions themselves stay; the index can be built again from the "
"active one."
msgstr ""
"Wektory dokumentów, notatek i pamięci w tym indeksie oraz pliki modelu na "
"tym serwerze zostaną usunięte. Zdalny punkt końcowy pozostanie bez zmian. "
"Same dokumenty, notatki i wyodrębnione treści zostaną zachowane. Indeks "
"można później odbudować na podstawie aktywnego indeksu."

#: app_ui/pages/admin.py:430
#, python-brace-format
msgid "Index deleted, and the model's files on this server ({gb} GB)."
msgstr "Usunięto indeks oraz pliki modelu z tego serwera ({gb} GB)."

#: app_ui/pages/admin.py:445
#, python-brace-format
msgid "Model removed, and its files on this server ({gb} GB)."
msgstr "Usunięto model oraz jego pliki z tego serwera ({gb} GB)."

#: app_ui/pages/admin.py:457
msgid "Model (Hugging Face id)"
msgstr "Identyfikator modelu w Hugging Face"


#: app_ui/pages/admin.py:462
msgid ""
"Runs on this server with sentence-transformers; the first use downloads it. "
"The index belongs to the model, so the id cannot change."
msgstr ""
"Działa na tym serwerze z użyciem sentence-transformers. Przy pierwszym "
"użyciu model zostanie pobrany. Indeks jest przypisany do modelu, dlatego "
"jego identyfikatora nie można zmienić."

#: app_ui/pages/admin.py:468
msgid ""
"Put before every search query, never before stored text. Empty = filled in "
"for known models (e5-instruct, Qwen3-Embedding)."
msgstr "Instrukcja jest dodawana przed każdym zapytaniem wyszukiwania, ale nie przed zapisywanym tekstem. Puste pole oznacza automatyczne uzupełnienie dla znanych modeli (e5-instruct, Qwen3-Embedding)."


#: app_ui/pages/admin.py:482
msgid ""
"Any OpenAI-compatible /v1/embeddings (Ollama, TEI, vLLM). The same model "
"remotely, e.g. to build a large index on a GPU and search it on this server "
"afterwards."
msgstr ""
"Dowolny punkt końcowy /v1/embeddings zgodny z OpenAI (Ollama, TEI, vLLM). "
"Umożliwia użycie tego samego modelu zdalnie, np. zbudowanie dużego indeksu "
"na GPU, a następnie przeszukiwanie go na tym serwerze."

#: app_ui/pages/admin.py:513
#, python-brace-format
msgid "Distance thresholds — {name}"
msgstr "Progi odległości — {name}"

#: app_ui/pages/admin.py:515
msgid ""
"All values are distances, as the tool log prints them: 0 = identical, lower "
"= closer. Each model spreads distances differently — the comparison below "
"shows this model's. Values marked \"default\" are the ones every install ran "
"with."
msgstr ""
"Wszystkie wartości oznaczają odległości podawane w dzienniku narzędzi: 0 "
"oznacza identyczność, a mniejsza wartość oznacza większe podobieństwo. Każdy "
"model ma inny rozkład odległości; porównanie poniżej pokazuje wyniki tego "
"modelu. Wartości oznaczone jako „domyślne” były używane we wszystkich "
"instalacjach."

#: app_ui/pages/admin.py:525
msgid "Memory and note hints: max. distance"
msgstr "Podpowiedzi z pamięci i notatek: maksymalna odległość"

#: app_ui/pages/admin.py:526
msgid "… and at most this factor above the best hint (≥ 1)"
msgstr ""
"…oraz maksymalnie tyle razy większa odległość niż dla najlepszej podpowiedzi "
"(≥ 1)"

#: app_ui/pages/admin.py:528
msgid "Hints from memory and notes shown next to search results."
msgstr "Podpowiedzi z pamięci i notatek wyświetlane obok wyników wyszukiwania."

#: app_ui/pages/admin.py:532
#, python-brace-format
msgid "The old setting \"similarity {sim}\" is the distance {dist}."
msgstr "Stare ustawienie „podobieństwo {sim}” odpowiada odległości {dist}."

#: app_ui/pages/admin.py:537
msgid "Archive hint on web search: max. distance"
msgstr ""
"Podpowiedź z archiwum podczas wyszukiwania w internecie: maksymalna odległość"

#: app_ui/pages/admin.py:538
msgid "\"A very similar fact exists\": max. distance"
msgstr "„Istnieje bardzo podobny fakt”: maksymalna odległość"

#: app_ui/pages/admin.py:546
msgid "Enter a number in every field."
msgstr "Wprowadź liczbę w każdym polu."

#: app_ui/pages/admin.py:576
msgid "For every user. The distance thresholds belong to each model, above."
msgstr ""
"Dotyczy wszystkich użytkowników. Progi odległości są przypisane do "
"poszczególnych modeli powyżej."

#: app_ui/pages/admin.py:597
msgid "Compare indexes"
msgstr "Porównaj indeksy"

#: app_ui/pages/admin.py:598
msgid ""
"Semantic search only, no language model: which documents each index finds, "
"and how fast. One model after the other, each alone in RAM."
msgstr ""
"Tylko wyszukiwanie semantyczne, bez modelu językowego: jakie dokumenty "
"znajduje każdy indeks i jak szybko. Modele są uruchamiane kolejno, po jednym "
"w pamięci RAM."

#: app_ui/pages/admin.py:608
msgid "Two models with an index are needed. Add a model and build its index."
msgstr "Potrzebne są dwa modele z indeksami. Dodaj model i zbuduj jego indeks."

#: app_ui/pages/admin.py:619
msgid "Questions, one per line"
msgstr "Pytania, po jednym w wierszu"

#: app_ui/pages/admin.py:634
msgid "Running — loading a model can take a minute …"
msgstr "Trwa porównywanie… Wczytanie modelu może potrwać minutę."

#: app_ui/pages/admin.py:687
#, python-brace-format
msgid "Load {s} s · query embedding {e} ms · vector search {v} ms (median)"
msgstr ""
"Wczytanie: {s} s · embedding zapytania: {e} ms · wyszukiwanie wektorowe: {v} "
"ms (mediana)"

#: app_ui/pages/admin.py:691
#, python-brace-format
msgid ""
"Distance of the best document {f}, of the last {l} (median) · {n} chunks"
msgstr ""
"Odległość najlepszego dokumentu: {f}, ostatniego: {l} (mediana) · fragmenty: "
"{n}"

#: app_ui/pages/admin.py:695
#, python-brace-format
msgid "Same documents in both lists, on average: {pct} %"
msgstr "Średni odsetek dokumentów wspólnych dla obu list: {pct} %"

#: app_ui/pages/admin.py:698
msgid "Documents you cannot see in Paperless are shown by number only."
msgstr ""
"Dokumenty, do których nie masz dostępu w Paperless, są wyświetlane tylko "
"jako numery."

#: app_ui/pages/admin.py:709
#, python-brace-format
msgid "{e} ms + {v} ms"
msgstr "{e} ms + {v} ms"

