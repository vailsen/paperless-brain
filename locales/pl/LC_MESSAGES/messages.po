#: app_ui/pages/admin.py:465
msgid "Query instruction"
msgstr "Instrukcja dla zapytania"

#: app_ui/pages/admin.py:470
msgid "Remote endpoint (optional)"
msgstr "Zdalny punkt końcowy (opcjonalnie)"

#: app_ui/pages/admin.py:473
msgid "Model name there"
msgstr "Nazwa modelu w zdalnej usłudze"

#: app_ui/pages/admin.py:481
msgid "stored — empty keeps it"
