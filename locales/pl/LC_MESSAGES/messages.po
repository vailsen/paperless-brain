#: app_ui/ai_models_settings.py:368
#, python-brace-format
msgid ""
"Its {n} model(s) are deleted with it. Settings that use one of them lose "
"their choice."
msgstr ""
"Jego/Jej {n} modele są usuwane razem z nim/nią. Ustawienia, które korzystają"
" z jednego z nich, tracą swój wybór."

#: app_ui/ai_models_settings.py:369
msgid "It has no models."
msgstr "Nie ma modeli."

#: app_ui/ai_models_settings.py:377
msgid "Service deleted."
