msgid "Move up"
msgstr "Nach oben"

#: app_ui/ai_models_settings.py:457 app_ui/ai_models_settings.py:498
msgid "Move down"
msgstr "Nach unten"

#: app_ui/ai_models_settings.py:465
msgid "No models yet."
msgstr "Noch keine Modelle."

#: app_ui/ai_models_settings.py:488
msgid "no tools"
msgstr "ohne Tools"

#: app_ui/ai_models_settings.py:491
msgid "Limited — cannot search documents, emails or notes."
msgstr "Eingeschränkt — kann weder Dokumente noch Mails oder Notizen durchsuchen."

#: app_ui/ai_models_settings.py:508
msgid ""
"One entry per service, with any number of models below it. Models appear "
"in dropdowns in this order, grouped by service.<br><b>OpenAI-"
"compatible</b>: Ollama (<code>http://host:11434/v1</code>), OpenRouter "
"(<code>https://openrouter.ai/api/v1</code>), MiniMax, Moonshot, …<br><b"
">Anthropic-compatible</b>: Anthropic API (empty base URL), MiniMax and "
"other providers with an Anthropic-compatible endpoint."
msgstr ""
"Ein Eintrag pro Dienst, darunter beliebig viele Modelle. In den "
"Auswahllisten erscheinen die Modelle in dieser Reihenfolge, nach Dienst "
"gruppiert.<br><b>OpenAI-kompatibel</b>: Ollama "
"(<code>http://host:11434/v1</code>), OpenRouter "
"(<code>https://openrouter.ai/api/v1</code>), MiniMax, Moonshot, …<br><b"
">Anthropic-kompatibel</b>: Anthropic-API (leere Basis-URL), MiniMax und "
"andere Anbieter mit Anthropic-kompatiblem Endpunkt."

