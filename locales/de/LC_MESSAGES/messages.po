msgid "Auto (model default)"
msgstr "Auto (Modell-Standard)"

#: app_ui/ai_models_settings.py:216
msgid "Thinking ON"
msgstr "Denken AN"

#: app_ui/ai_models_settings.py:216
msgid "Thinking OFF"
msgstr "Denken AUS"

#: app_ui/ai_models_settings.py:217
msgid "Thinking mode"
msgstr "Denkmodus"

#: app_ui/ai_models_settings.py:222
msgid ""
"\"Auto\" leaves the decision to the model — Claude then never thinks, and"
" other models only sometimes. Set it explicitly to decide yourself."
msgstr ""
"„Auto“ überlässt die Entscheidung dem Modell — Claude denkt dann nie, "
"andere Modelle nur manchmal. Setze den Wert explizit, um selbst zu "
"entscheiden."

#: app_ui/ai_models_settings.py:236
msgid "Model default"
msgstr "Modell-Standard"

#: app_ui/ai_models_settings.py:237 proactive/notify/__init__.py:24
msgid "Low"
msgstr "Niedrig"

#: app_ui/ai_models_settings.py:238 proactive/notify/__init__.py:25
msgid "Medium"
msgstr "Mittel"

#: app_ui/ai_models_settings.py:239 proactive/notify/__init__.py:26
msgid "High"
msgstr "Hoch"

#: app_ui/ai_models_settings.py:240
msgid "Very high"
msgstr "Sehr hoch"

#: app_ui/ai_models_settings.py:241
msgid "Maximum"
msgstr "Maximal"

#: app_ui/ai_models_settings.py:243
msgid "Thinking effort (Anthropic, no base URL)"
msgstr "Denk-Aufwand (Anthropic, ohne Basis-URL)"

#: app_ui/ai_models_settings.py:248
msgid "Thinking budget in tokens (0 = 4096)"
msgstr "Denk-Budget in Token (0 = 4096)"

#: app_ui/ai_models_settings.py:254
msgid "⚠ Qwen3 thinking-loop risk at temp. < 0.5 — recommended: ≥ 0.6"
msgstr "⚠ Qwen3 Thinking-Loop-Risiko bei Temp. < 0.5 — empfohlen: ≥ 0.6"

#: app_ui/ai_models_settings.py:262
msgid "Model can use tools"
msgstr "Modell kann Tools nutzen"

#: app_ui/ai_models_settings.py:266
msgid ""
"Off: this model is never offered tools. Use for models that cannot call "
"them reliably — better a model that says it does not know than one that "
"invents an answer."
msgstr ""
"Aus: Diesem Modell werden nie Tools angeboten. Für Modelle, die sie nicht"
" zuverlässig aufrufen — besser ein Modell, das sagt, dass es nichts weiß,"
" als eines, das eine Antwort erfindet."

#: app_ui/ai_models_settings.py:272
msgid "Require a tool for personal questions"
msgstr "Tool bei persönlichen Fragen erzwingen"

#: app_ui/ai_models_settings.py:277
msgid ""
"For questions about your own documents, emails or purchases, the first "
"request already demands a tool call. Switch on for models that answer "
"such questions from memory."
msgstr ""
"Bei Fragen zu eigenen Dokumenten, Mails oder Käufen verlangt schon die "
"erste Anfrage einen Tool-Aufruf. Für Modelle einschalten, die solche "
"Fragen aus dem Gedächtnis beantworten."

#: app_ui/ai_models_settings.py:286
msgid "Model ID must not be empty."
msgstr "Die Modell-ID darf nicht leer sein."

#: app_ui/ai_models_settings.py:292
#, python-brace-format
