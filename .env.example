# PaperlessBrain — minimal configuration. Copy to .env and fill in.
# Every other setting has a sane default or is configured in the app's
# Settings page. See .env.example.full for the complete annotated reference.

# Path to the app root, with trailing slash. Docker: /app/ — do not change.
APP_PATH=/app/

# --- Paperless-ngx ---
PAPERLESS_URL=http://paperless.example.lan:8000
PAPERLESS_SUPERUSER_TOKEN=changeme

# --- Vault (Markdown notes + agent memory) ---
# Path INSIDE the container. Leave as is; choose the host location in
# docker-compose.yml:  - /your/obsidian/vault/parent:/mnt/vaults
VAULT_ROOT=/mnt/vaults

# --- Embeddings / ChromaDB ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
CHROMA_PATH=data/chroma_db/
CHROMA_COLLECTION=paperless_documents
EXTRACTION_SIDECAR_PATH=data/extractions/
THUMB_PATH=data/thumbnails/

# --- Ollama (vision model for document ingestion) ---
# Chat models are configured per user in Settings > AI Models, not here.
OLLAMA_SERVER=http://ollama.example.lan:11434
OLLAMA_INGEST_MODEL=qwen2.5vl:7b

# --- NiceGUI ---
# python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_SECRET=changeme

# --- Optional ---
#SEARXNG_HOST=http://searxng.example.lan:8888   # enables the web-search tool
#TZ=Europe/Berlin                               # timestamps on generated documents
#ANTHROPIC_API_KEY=                             # fallback key; per-user keys live in the UI
