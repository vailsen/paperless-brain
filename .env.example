# PaperlessBrain — minimal configuration. Copy to .env and fill in.
# Every other setting has a sane default or is configured in the app's
# Settings page. See .env.example.full for the complete annotated reference.

# Path to the app root, with trailing slash. Docker: /app/ — do not change.
APP_PATH=/app/

# --- Paperless-ngx ---
PAPERLESS_URL=http://paperless.example.lan:8000
PAPERLESS_SUPERUSER_TOKEN=changeme

# --- Vault (Markdown notes + agent memory) ---
# Path INSIDE the container. Leave as is; choose the host location in
# docker-compose.yml:  - /your/obsidian/vault/parent:/mnt/vaults
VAULT_ROOT=/mnt/vaults

# --- Embeddings / ChromaDB ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
CHROMA_PATH=data/chroma_db/
CHROMA_COLLECTION=paperless_documents
EXTRACTION_SIDECAR_PATH=data/extractions/
THUMB_PATH=data/thumbnails/

# --- NiceGUI ---
# python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_SECRET=changeme

# --- Optional ---
# Only settings that have no place in the UI live here. Chat models and API
# keys (Settings > AI Models), the ingestion server and vision model
# (Settings > Processing) and everything else marked [UI] in
# .env.example.full are configured in the running app instead.

#SEARXNG_HOST=http://searxng.example.lan:8888   # enables the web-search tool
#TZ=Europe/Berlin                               # timestamps on generated documents
#SHOW_RELEVANCE_SCORES=true                     # debug: show retrieval scores on result cards

# --- Optional: power control for a GPU box running Ollama ---
# Wake it from the dashboard, shut it down when idle. Leave the MAC and the SSH
# user empty to hide the buttons entirely. None of this is configurable in the
# UI. Requires the app on the same L2 network (Docker: network_mode: host).
# Which machine the buttons control: OLLAMA_SERVER. Without it the host is
# inferred from your first local-lane model, and shutdown refuses to act when
# several local models point at different hosts.
#OLLAMA_SERVER=http://192.168.1.50:11434
#OLLAMA_HOST_LAN_MAC_ADDRESS_WOL=aa:bb:cc:dd:ee:ff
# SSH user on that host. Needs passwordless sudo for /usr/bin/shutdown, and in
# Docker an SSH key mounted into the container (see docker-compose.yml).
#OLLAMA_SSH_USER=
#OLLAMA_IDLE_SHUTDOWN_MINUTES=30
# Prompts for this before shutting down. Empty = no confirmation.
#SHUTDOWN_PASSWORD=
