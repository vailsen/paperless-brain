{
  "name": "pb-vault-editor",
  "private": true,
  "description": "CodeMirror 6 bundle for the note vault's live-preview editor (app_ui/vault_editor). Built by scripts/build_vault_editor.sh; the output in dist/ is committed.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.mjs --bundle --format=esm --splitting --minify --target=es2020 --outdir=dist --chunk-names=chunks/[name]-[hash]"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@lezer/markdown": "1.8.2",
    "esbuild": "0.28.2"
  }
}
